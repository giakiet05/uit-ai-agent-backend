# OpenAI API Key (for PageIndex tree building)
OPENAI_API_KEY=your_openai_api_key_here

# LlamaCloud API Key (for PDF parsing)
LLAMA_CLOUD_API_KEY=your_llamacloud_api_key_here

# Optional: Override default LLM settings
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini

# Optional: Override PageIndex settings
# ADD_NODE_SUMMARY=no
# ADD_NODE_TEXT=yes
# TREE_BUILD_MODEL=gpt-5-mini

# Optional: Override LlamaParse settings
# PARSE_MODE=parse_page_with_agent
# PARSE_MODEL=openai-gpt-4-1-mini
